FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         Euler;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{

    default         none;

    div(rhoPhi,U)           bounded Gauss Gamma 1;

    "div\(phi,alpha.*\)"        Gauss vanLeer;
    "div\(phir,alpha.*\)"       Gauss vanLeer;

    "div\(phi,alpha.*\)"        Gauss vanLeer;
    "div\(Yiphir,alpha.*\)"     Gauss vanLeer;

    "div\(phi,.*\.stationary.*\)"      Gauss vanLeer01;
    "div\(phi,.*\.mobile.*\)"   Gauss vanLeer01;

    div(((rho*nuEff)*dev2(T(grad(U))))) Gauss linear;

    div(phi,T)              Gauss linearUpwind gradT;
}

laplacianSchemes
{
    default         Gauss linear orthogonal;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         orthogonal;
}

fluxRequired
{
    default         no;
    p_rgh           ;
    alpha.stationary       ;
    alpha.mobile    ;
    Xc.stationary ;
    Xc.mobile ;
}


