FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties.gas;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         multiComponentMixture;
    transport       const;
    thermo          hConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleEnthalpy;
}

species
(
    organic
    c
);

inertSpecie organic;
forceZeroOnOtherPhase false;

organic // ethanol
{
    specie
    {
        nMoles          1;
        molWeight       46.068;
    }
    equationOfState
    {
        rho             789.4;
    }
    thermodynamics
    {
        Cp              4216;
        Hf              -2.45e6;
    }
    transport
    {
        Pr              6.62;
        mu              959e-6;
    }
}

c // methanol
{
    specie
    {
        nMoles          1;
        molWeight       32.04;
    }
    equationOfState
    {
        rho             792;
    }
    thermodynamics
    {
        Cp              4216;
        Hf              -2.45e6;
    }
    transport
    {
        Pr              6.62;
        mu              959e-6;
    }

}



