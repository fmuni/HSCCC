FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;

    object      phaseProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type    massTransferMultiphaseSystem;

phases  (mobile stationary);

mobile
{
    type             multiComponentMovingPhaseModel;
}

stationary
{
    type            multiComponentMovingPhaseModel;
}

surfaceTension
(
    (mobile and stationary)
    {
        type            constant;
        sigma           0.03;
    }
);


massTransferModel
(
    (stationary to mobile)
    {
        type                kineticallyLimitedPartitioning;
        species             (c);
        kL                  1e-5;
        K                   2;
        Tactivate           372;
   } 
);


