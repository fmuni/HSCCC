FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions          [0 0 0 1 0 0 0];

internalField       uniform 375;

boundaryField
{
    left
    {
        type            zeroGradient;
        value           $internalField;
    }

    right
    {
        type            zeroGradient;
        value           $internalField;
    }

    bottom
    {
        type            fixedValue;
        value           $internalField;
    }

    top
    {
        type            fixedValue;
        value           $internalField;
    }

    inlet
    {
        type            fixedValue;
        value           $internalField;
    }

    outlet
    {
        type            inletOutlet;
        value           uniform 375;
        inletValue      uniform 375;
    }

    frontAndBack
    {
        type            empty;
    }
}


