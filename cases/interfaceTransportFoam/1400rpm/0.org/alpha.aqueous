FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      alpha.aqueous;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 1;

boundaryField
{
   inlet
   {
        type    codedFixedValue;
        value   uniform 1;
        name    instep;   // name of generated BC

        code
        #{
            scalar timeStart(0.214285714);
            if(this->db().time().value() > timeStart)
            {
                operator==(0);
            }
            
        #};

        //codeInclude
        //#{
        //    #include "fvCFD.H"
        //#};

        //codeOptions
        //#{
        //    -I$(LIB_SRC)/finiteVolume/lnInclude
        //#};
    }
    outlet
    {
        type            zeroGradient;
    }
    pipe
    {
        type            zeroGradient;
    }
}


// ************************************************************************* //
