FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phases (aqueous organic);

aqueous // water
{
    transportModel  Newtonian;
    nu              1e-06;
    rho             1000;
}

organic // dodecane
{
    transportModel  Newtonian;
    nu              1.34e-06;
    rho             750;
}


sigma              0.03 ;

species ();


