FoamFile
{
    version   2.0;
    format    ascii;
    class     dictionary;
    location  "system";
    object    meshDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

surfaceFile "coil.stl";

Rin 0.0016;
cellResolution 5;
wallRefine 0.5;

maxCellSize #calc "$Rin/$cellResolution";

//boundaryCellSize 2.0;

localRefinement
{
//    "walls"
//    {
//        cellSize #calc "$maxCellSize*$wallRefine";
//    }
}

boundaryLayers
{
    nLayers 0;
}

renameBoundary
{
    defaultName walls;
    defaultType wall;

    newPatchNames
    {
        "inlet.*"
        {
            type    patch;
            newName inlet;
        }

        "outlet.*"
        {
            type    patch;
            newName outlet;
        }
    }
}


