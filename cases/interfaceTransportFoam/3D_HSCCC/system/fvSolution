FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "alpha.aqueous.*"
    {
        isoFaceTol      1e-10;
        surfCellTol     1e-6;
        nAlphaBounds    2;
	    nAlphaSmoothCurvature 3;
        snapTol         1e-12;
        clip            false;
        reconstructionScheme isoAlpha;
        writeFields     true;

        nAlphaSubCycles 2;
        cAlpha          1; // Note: cAlpha is not used by isoAdvector but must
                           // be specified because interfacePropertes object
                           // reads it during construction.
    }

    "pcorr.*"
    {
        solver          GAMG;
	    smoother        GaussSeidel;
	    maxIter		100;
        preconditioner  DIC;
        tolerance       1e-10;
        relTol          0;
    }

    p_rgh
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-09;
        relTol          0.01;
	    maxIter		20;
    }

    p_rghFinal
    {
        $p_rgh;
        tolerance       1e-09;
        relTol          0;
	    maxIter		20;
    }

    "U|UFinal"
    {
        solver          GAMG;
        smoother  GaussSeidel;
        tolerance       1e-08;
        relTol          0;
    }
}


PIMPLE
{
    momentumPredictor yes;
    nCorrectors     10;
    nOuterCorrectors 1;
    nNonOrthogonalCorrectors 0;
    pRefCell        0;
    pRefValue       0;
}

relaxationFactors
{
    fields
    {
      p_rgh 0.5;
    }
    equations
    {
      U 0.7;
      ".*" 0.99;
    }
 
} 

